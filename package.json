{
  "name": "@hustshawn/dsh-artifact-preview",
  "version": "0.1.0",
  "description": "Claude-style Artifacts for DeepSeek Harness: preview HTML and Markdown files the agent writes in a resizable side panel",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "artifacts",
    "preview"
  ],
  "license": "MIT",
  "author": "Shawn Zhang <hustshawn@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hustshawn/dsh-artifact-preview.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json && tsdown",
    "clean": "rm -rf lib"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.7",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "tsdown": "^0.22.2",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": "^22.19 || >=24"
  }
}
